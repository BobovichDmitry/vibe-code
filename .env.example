# =============================================================================
# VibeSetup UI — корневой .env (НЕ в git; .gitignore: /­.env)
# Используется: scripts/ssh.sh (MCP ssh-connect) и deploy.sh (локальный деплой)
# Значения со спецсимволами/пробелами — в кавычках.
# =============================================================================

# --- SSH (для MCP ssh-connect и deploy.sh) ---
# SSH_HOST — домен или IP целевого сервера
SSH_HOST="31.77.193.104"
# SSH_PORT — SSH-порт (по умолчанию 22)
SSH_PORT="22"
# SSH_USER — пользователь для входа по SSH
SSH_USER="root"

# Аутентификация — ВАРИАТИВНО (ключ приоритетнее пароля):
#   • Если задан SSH_KEY — подключение по ключу (auth=key).
#     Можно с ~:  ~/.ssh/id_ed25519
#     На Windows лучше прямые слеши: C:/Users/you/.ssh/id_ed25519
#     Если ключ запаролен — задайте SSH_KEY_PASSPHRASE (для MCP ssh-mcp).
#     Для deploy.sh ключ грузится в ssh-agent (passphrase спросится один раз,
#     либо ключ уже в системном агенте — тогда без запроса).
#   • Иначе — по паролю (SSH_PASSWORD).
SSH_KEY="C:/Users/amorev/.ssh/id_rsa"
SSH_KEY_PASSPHRASE=""
# SSH_PASSWORD=""

# =============================================================================
# --- Деплой (deploy.sh → ansible → nginx-proxy + Let's Encrypt → HTTPS)
# =============================================================================
# DOMAIN — домен, на котором поднимается проект. DNS A-запись домена должна
#          указывать на SSH_HOST. Под ним nginx-proxy маршрутизирует трафик,
#          а acme-companion выпускает Let's Encrypt-сертификат (HTTPS).
DOMAIN="big-vibe.hopto.org"

# LETSENCRYPT_EMAIL — email для Let's Encrypt (уведомления о сроках сертификатов).
#                      Обязателен для выпуска HTTPS-сертификата.
LETSENCRYPT_EMAIL="admin@big-vibe.hopto.org"

# --- Брендинг (публичный GET /api/branding) ---
BRAND_TITLE="Вайбкодинг от Галеры Морева"
BRAND_FAVICON_URL="/favicon.svg"

# --- Проект (мульти-проект на одном сервере) ---
# PROJECT_NAME — слаг проекта. Исходники кладутся в /opt/<PROJECT_NAME>,
# контейнеры/тома/сети получают префикс <PROJECT_NAME> (docker compose -p).
# Общий nginx-proxy — один на сервер; каждый проект подключается со своим VIRTUAL_HOST.
PROJECT_NAME="gmoreva-setup"

# --- Первый админ (создаётся только на пустой БД; забирается из .env) ---
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="ChangeMe_StrongPassword1!"

# --- Секреты приложения (DB_PASSWORD, JWT_SECRET) НЕ хранятся в .env ---
# deploy.sh генерирует их автоматически на сервере в /opt/<PROJECT_NAME>/.app.secrets
# (не в git) и переиспользует при повторных деплоях. См. .app.secrets.example.

# --- Пути на сервере (опционально, по умолчанию выводятся из PROJECT_NAME) ---
# PROJECT_DIR="/opt/gmoreva-setup"
# ARCHIVE_PATH="/opt/gmoreva-setup.tar.gz"