# SSH credentials for the pi MCP server (.pi/mcp.json):
#   ssh-connect → scripts/ssh.sh (npx ssh-mcp v2 — SSH + SFTP)
#
# Copy this file to `.env` at the repo root and fill in real values.
# `.env` is gitignored — secrets are NOT committed.
#
# SSH_HOST    — домен или IP целевого сервера (например app.example.com или 203.0.113.10)
# SSH_PORT    — SSH-порт (по умолчанию 22; на некоторых серверах нестандартный, напр. 2091)
# SSH_USER    — пользователь для входа по SSH (для деплоя удобно root или sudo-пользователь)
# SSH_PASSWORD — пароль. Для key-based auth замените скрипт на ssh-ключ / SSH agent
#               (then drop SSH_PASSWORD and use SSH_AUTH_SOCK / --key=/path/to/key).
#
# Примечание: ssh-mcp v2 читает пароль из SSH_MCP_PASSWORD — scripts/ssh.sh мапит
# SSH_PASSWORD → SSH_MCP_PASSWORD автоматически. Approval отключён (--disableApproval),
# чтобы агент работал автономно; policy-engine и forbidden-list всё равно действуют.

SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=