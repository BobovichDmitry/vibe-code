# SSH credentials for the pi MCP servers (.pi/mcp.json):
#   - ssh-connect  → scripts/ssh.sh  (npx ssh-mcp)
#   - sftp-connect → scripts/sftp.sh (npx sftp-ssh-mcp)
#
# Copy this file to `.env` at the repo root and fill in real values.
# `.env` is gitignored — secrets are NOT committed.
#
# SSH_HOST — домен или IP целевого сервера (например app.example.com или 203.0.113.10)
# SSH_PORT — SSH-порт (по умолчанию 22; на некоторых серверах нестандартный, напр. 2091)
# SSH_USER — пользователь для входа по SSH
# SSH_PASSWORD — пароль (для key-based auth замените скрипт на ssh -i <keyfile>)

SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=