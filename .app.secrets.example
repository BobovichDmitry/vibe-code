# =============================================================================
# .app.secrets — секреты приложения (DB_PASSWORD, JWT_SECRET)
# =============================================================================
# Этот файл АВТОМАТИЧЕСКИ ГЕНЕРИРУЕТСЯ на сервере скриптом deploy.sh
# (случайные значения) и хранится на сервере в {{ project_dir }}/.app.secrets.
# Он НЕ под версионным контролем (.gitignore: .app.secrets) — не коммитить.
#
# При повторных деплоях deploy.sh переиспользует существующий .app.secrets
# (секреты не перевыпускаются, БД не пересоздаётся).
#
# Формат — YAML, подтягивается в ansible vars.yml и рендерится в docker/env:
#   db_password  → DB_PASSWORD (PostgreSQL)
#   jwt_secret   → JWT_SECRET  (подпись JWT приложения)
#
# Ниже — ПРИМЕР. Не заполняйте вручную (deploy.sh сгенерирует сам).
# Чтобы пересоздать секреты — удалите .app.secrets на сервере и запустите deploy.sh
# (приведёт к пересозданию БД с новым паролем).

db_password: "CHANGE_ME_random_24_plus_chars"
jwt_secret: "CHANGE_ME_random_32_hex_chars"