# =============================================================================
# Шаблон docker/env для приложения (прод-режим)
# Рендерится ansible-ролью app в {{ project_dir }}/docker/env
# =============================================================================

# === Сервер ===
PORT=3000

# === CORS (домен за nginx-proxy) ===
CORS_ORIGIN={{ cors_origin }}

# === Безопасность ===
JWT_SECRET={{ jwt_secret }}

# === PostgreSQL (production) ===
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME={{ db_username }}
DB_PASSWORD={{ db_password }}
DB_DATABASE={{ db_name }}
DB_SYNCHRONIZE=false

# === Первый админ (только на пустой БД) ===
ADMIN_LOGIN={{ admin_login }}
ADMIN_PASSWORD={{ admin_password }}

# === Брендинг (из задачи 04) ===
BRAND_TITLE={{ brand_title }}
BRAND_FAVICON_URL={{ brand_favicon_url }}

# === nginx-proxy (маршрутизация + Let's Encrypt) ===
VIRTUAL_HOST={{ domain }}
LETSENCRYPT_HOST={{ domain }}
LETSENCRYPT_EMAIL={{ letsencrypt_email }}