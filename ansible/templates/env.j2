# =============================================================================
# Шаблон docker/env (backend + переменные для compose-интерполяции).
# Рендерится ansible-ролью app в {{ project_dir }}/docker/env
#
# Структура сервисов (prod, blue-green 0downtime):
#   edge-nginx (VIRTUAL_HOST) → frontend-<slot> (Nuxt SSR, 3000) → backend-<slot>;
#   postgres — общий для слотов. Активный слот — docker/.active-slot
#   (переключает docker/deploy_0downtime.sh).
# =============================================================================

# === Backend server (внутренний API, 3001) ===
PORT=3001

# === CORS (домен за nginx-proxy; клиентский fetch браузера) ===
CORS_ORIGIN={{ cors_origin }}

# === Cookie-auth: secure=true в проде (HTTPS за nginx-proxy) ===
COOKIE_SECURE=true

# === Безопасность ===
JWT_SECRET={{ jwt_secret }}

# === PostgreSQL (production) ===
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME={{ db_username }}
DB_PASSWORD={{ db_password }}
DB_DATABASE={{ db_name }}
DB_SYNCHRONIZE=false

# === Первый админ (только на пустой БД) ===
ADMIN_LOGIN={{ admin_login }}
ADMIN_PASSWORD={{ admin_password }}

# === Брендинг ===
BRAND_TITLE={{ brand_title }}
BRAND_FAVICON_URL={{ brand_favicon_url }}

# === nginx-proxy (маршрутизация + Let's Encrypt) — для frontend-сервиса ===
VIRTUAL_HOST={{ domain }}
LETSENCRYPT_HOST={{ domain }}
LETSENCRYPT_EMAIL={{ letsencrypt_email }}

# === Производные от DOMAIN (generic, закомментированы — раскомментируй нужное) ===
# Generic pass-through не знает, какие переменные, выводимые из домена, нужны
# приложению форка — они не генерятся автоматически. Ниже — шаблоны для типовых
# случаев (раскомментируй ИЛИ задай своё значение в .envs/<env>/public.yaml —
# значение из public.yaml перекроет шаблон).
# PUBLIC_BASE_URL=https://{{ domain }}

# === Дополнительно прокидываемые переменные окружения (generic pass-through) ===
# extra_env наполняется деплой-скриптами (deploy.sh / deploy_ci.sh) любыми
# переменными, заданными в .env / .envs/<env>/*.yaml — форк управляет
# окружением из git без правок ansible-шаблона.
{% for key, value in (extra_env | default({}, true)).items() %}
{{ key }}={{ value }}
{% endfor %}
