# Секретные переменные test-стенда. Этот файл НЕ коммитится (.gitignore),
# в git хранится его sops-шифрование — secret.enc.yaml.
#
# Цикл работы (см. scripts/encrypt.sh / scripts/decrypt.sh):
#   1) отредакруй этот файл;
#   2) bash scripts/encrypt.sh test  → обновляет .envs/test/secret.enc.yaml;
#   3) закоммить secret.enc.yaml.
#
# Ключи — ВЕРХНИМ регистром (экспортируются как переменные окружения).
ADMIN_PASSWORD: change-me
# base64 приватного SSH-ключа деплоя (id_rsa, БЕЗ passphrase):
#   Linux/macOS: base64 -w0 path/to/id_rsa
#   Git Bash:    base64 -w0 path/to/id_rsa   (или "openssl base64 -A -in id_rsa")
DEPLOY_SSH_KEY: ""

# --- Telegram-уведомления деплоя (опционально) ---
# Если заданы ОБЕ переменные — docker/deploy_0downtime.sh присылает
# уведомления о деплое (start → итог: active slot / время / результат).
# Не заданы — уведомления молча пропускаются.
#BOT_TOKEN: ""
#TELEGRAM_NOTIFY_CHAT: ""
# опционально: id топика в группе (message_thread_id)
#TELEGRAM_NOTIFY_TOPIC: ""
