# .env.local — ЛОКАЛЬНЫЕ переопределения (НЕ под версионным контролем).
#
# Скопируйте в .env.local (рядом с .env) и впишите свои значения.
# Значения отсюда перезаписывают одноимённые из .env. Реальное переменное
# окружение (прод-контейнер, systemd) имеет наивысший приоритет — dotenv
# его не трогает.
#
# Файл игнорируется git (см. корневой .gitignore: `.env.local`, `.env.*.local`).

# === Порт backend (API) ===
# По умолчанию 3001 (PORT в .env). Пересоздавать/комментировать необязательно —
# переменная уже есть в .env; здесь её можно просто переопределить.
# Если меняете порт — обновите также NUXT_API_BASE в apps/frontend/.env.local,
# чтобы прокси /api у frontend попадал на этот backend.
# PORT=3001

# === S3 / MinIO — локальные креды для разработки ===
S3_ENDPOINT=http://localhost:9000
# Публичный URL для presigned-ссылок (если отличается от внутреннего endpoint).
# Для MinIO на локальной машине обычно совпадает с S3_ENDPOINT.
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=my-local-bucket
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Префикс-папка для рандомных ключей (напр. uploads/). Пусто = без префикса.
S3_KEY_PREFIX=
# forcePathStyle: true для MinIO/самохоста
S3_FORCE_PATH_STYLE=true