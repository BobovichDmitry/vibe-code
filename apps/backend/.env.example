# Database type: sqlite | postgres
DB_TYPE=sqlite

# PostgreSQL (used when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=app_db

# SQLite
DB_SQLITE_PATH=./data/database.sqlite

# Server (backend = внутренний API, 3001; Nuxt frontend на 3000 проксирует /api сюда)
PORT=3001

# JWT
JWT_SECRET=dev-secret-change-me

# Default admin credentials (used only on empty DB)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# Branding (public, no DB)
BRAND_TITLE=VibeSetup UI
BRAND_FAVICON_URL=/favicon.svg

# Cookie-auth: secure=true в проде (HTTPS). Пусто/false в dev (http).
COOKIE_SECURE=

# CORS origins (comma-separated) — Nuxt-origin (dev http://localhost:3000)
CORS_ORIGIN=http://localhost:3000
