# Database type: sqlite | postgres
DB_TYPE=sqlite

# Schema mode: true = synchronize (dev), false = migrations (prod)
DB_SYNCHRONIZE=true

# PostgreSQL (used when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=app_db

# SQLite
DB_SQLITE_PATH=./data/database.sqlite

# Server
PORT=3000

# JWT
JWT_SECRET=dev-secret-change-me

# Default admin credentials (used only on empty DB)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# Branding (public, no DB)
BRAND_TITLE=VibeSetup UI
BRAND_FAVICON_URL=/favicon.svg

# CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# === S3 / object storage ===
# Endpoint (внутренний) и публичный URL (для presigned) — могут совпадать
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Префикс-папка для рандомных ключей (напр. uploads/)
S3_KEY_PREFIX=
# Срок действия presigned URL, сек
S3_UPLOAD_EXPIRES=600
S3_DOWNLOAD_EXPIRES=86400
# forcePathStyle для S3Client (true для MinIO/самохоста)
S3_FORCE_PATH_STYLE=true
