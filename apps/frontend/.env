# Nuxt runtime config overrides (переопределяют дефолты из nuxt.config.ts)
#
# PORT          — порт dev-сервера (nuxt dev), по умолчанию 3000.
#                 Удобнее задавать в .env.local (см. .env.local.example).
# public.apiBase — клиентский base (браузер → свой origin → Nitro прокси /api).
#                  По умолчанию '/api' (см. nuxt.config.ts).
# apiBase       — серверный base при SSR (прямой fetch к backend).
#                  В dev: http://localhost:3001/api
#                  В prod (docker): http://backend:3001/api (hostname = имя сервиса)
#                  Чтобы вынести frontend на отдельный сервер — укажите публичный URL backend.
#
# Если меняете порт бэкенда (PORT в apps/backend/.env/.env.local), обновите и
# NUXT_API_BASE, иначе прокси /api не попадёт на backend.
#
# PORT=3000
# NUXT_PUBLIC_API_BASE=/api
# NUXT_API_BASE=http://localhost:3001/api