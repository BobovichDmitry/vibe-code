# Browser mode (env-controlled)
# E2E_USE_BROWSER: 'true' (default) — browser tests enabled; 'false' — API-only tests (axios, no browser)
E2E_USE_BROWSER=true
# E2E_HEADLESS: 'false' (default) — CDP mode (connectOverCDP to REMOTE_CHROME_HOST:BROWSER_PORT);
#   'true' — Playwright launches chromium in headless mode (chromium.launch)
E2E_HEADLESS=true

# Path to chrome.exe (used in headless mode, and in CDP mode to auto-launch Chrome if not already running)
# Example: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"

# CDP connection (used only when E2E_USE_BROWSER=true + E2E_HEADLESS=false)
BROWSER_PORT=9222
REMOTE_CHROME_HOST=localhost

# Base URL of the application under test
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:3000/api
