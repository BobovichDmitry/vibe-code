# =============================================
# Production environment template (backend service)
# =============================================
# Copy to .env and fill in real values.
# Backend (Nest API) слушает 3001; frontend (Nuxt SSR) на 3000 проксирует /api.

# === Server (backend = внутренний API, 3001) ===
PORT=3001

# === CORS ===
# Comma-separated list of allowed origins (домен за nginx-proxy).
CORS_ORIGIN=https://app.example.com

# === Cookie-auth: secure=true в проде (HTTPS) ===
COOKIE_SECURE=true

# === Security ===
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-random-JWT-secret>

# === Database ===
# For single-container mode (SQLite):
#   DB_TYPE=sqlite
#   DB_SQLITE_PATH=./data/database.sqlite
#
# For Docker Compose with PostgreSQL:
DB_TYPE=postgres
DB_SYNCHRONIZE=false
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=<project-slug>
DB_PASSWORD=<generate-a-16+char-random-password>
DB_DATABASE=<project-slug>_db

# === First admin (created automatically on empty DB) ===
ADMIN_LOGIN=admin
ADMIN_PASSWORD=<strong-password>

# === Branding ===
BRAND_TITLE=VibeSetup UI
BRAND_FAVICON_URL=/favicon.svg

# === nginx-proxy (frontend edge) ===
VIRTUAL_HOST=app.example.com
LETSENCRYPT_HOST=app.example.com
LETSENCRYPT_EMAIL=admin@example.com