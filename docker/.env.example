# =============================================
# Production environment template
# =============================================
# Copy to .env and fill in real values.

# === Server ===
PORT=3000

# === CORS ===
# Comma-separated list of allowed origins (used when running without nginx-proxy)
CORS_ORIGIN=http://localhost:3000

# === Security ===
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-random-JWT-secret>

# === Database ===
# For single-container mode (SQLite):
#   DB_TYPE=sqlite
#   DB_SQLITE_PATH=./data/database.sqlite
#
# For Docker Compose with PostgreSQL:
DB_TYPE=postgres
DB_SYNCHRONIZE=false
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=<generate-a-16+char-random-password>
DB_DATABASE=app_db

# === First admin (created automatically on empty DB) ===
ADMIN_LOGIN=admin
ADMIN_PASSWORD=<strong-password>
