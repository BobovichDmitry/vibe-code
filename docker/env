# =============================================
# Production configuration
# =============================================

# === Server ===
PORT=3000

# === CORS (domain behind nginx-proxy) ===
CORS_ORIGIN=https://app.example.com

# === Security ===
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-random-JWT-secret>

# === PostgreSQL (production) ===
DB_TYPE=postgres
DB_SYNCHRONIZE=false
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=<generate-a-16+char-random-password>
DB_DATABASE=app_db

# === First admin account (only on empty DB) ===
ADMIN_LOGIN=admin
ADMIN_PASSWORD=<strong-password>

# === S3 / object storage ===
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_KEY_PREFIX=
S3_UPLOAD_EXPIRES=600
S3_DOWNLOAD_EXPIRES=86400
S3_FORCE_PATH_STYLE=true
