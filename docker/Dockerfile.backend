# =============================================================================
# Dockerfile.backend — Nest.js (API на /api), порт 3001 (внутренний).
# Frontend (Nuxt SSR) на 3000 проксирует /api/** сюда; внешний трафик идёт
# только на Nuxt, поэтому backend НЕ объявляет VIRTUAL_HOST.
# Multi-stage: deps → nest build → production-образ.
# =============================================================================

# ---------- Stage 1: deps ----------
FROM node:22-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/frontend/package.json ./apps/frontend/
COPY apps/backend/package.json ./apps/backend/
COPY e2e/package.json ./e2e/

RUN npm install --no-audit --no-fund

# ---------- Stage 2: build Nest ----------
FROM node:22-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY apps/backend/ ./apps/backend/

RUN npm run build --workspace=apps/backend && \
    npm prune --production --workspace=apps/backend

# ---------- Stage 3: production ----------
FROM node:22-alpine AS production
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001

# Каталог под SQLite (если DB_TYPE=sqlite).
RUN mkdir -p /app/apps/backend/data

COPY package.json package-lock.json ./
COPY apps/frontend/package.json ./apps/frontend/
COPY apps/backend/package.json ./apps/backend/
COPY e2e/package.json ./e2e/
# npm ci (не install) — строго по локфайлу: без лока workspace+omit=dev ловит
# баг arborist «Cannot read properties of null (reading 'edgesOut')» в npm 10.9.x.
RUN npm ci --omit=dev --no-audit --no-fund --workspace=apps/backend

# dist/ включает скомпилированные миграции (dist/migrations/*.js) —
# нужны в проде (DB_SYNCHRONIZE=false → migrationsRun на старте).
COPY --from=builder /app/apps/backend/dist ./apps/backend/dist

EXPOSE 3001

CMD ["node", "apps/backend/dist/main.js"]